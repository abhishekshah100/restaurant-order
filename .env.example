# Copy to .env.local for local development. Every variable is read at build time.

# The real backend (restaurant-backend), with its version path. The endpoints it serves today
# (src/api/backend.ts) go to it; everything else stays on the mock and the dummy JSON.
# Leave unset to run on the mock alone.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/v1

# The in-browser mock server for the endpoints the backend doesn't serve yet (on unless "false").
NEXT_PUBLIC_API_MOCK=true

# Mock response time in ms: a range or one number.
NEXT_PUBLIC_API_MOCK_LATENCY_MS=200-400
